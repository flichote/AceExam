# AceExam Backend — Environment Variables
# Copy this to .env and fill in your values.
# .env is git-ignored — NEVER commit real secrets.

# PostgreSQL (asyncpg-compatible URL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/aceexam

# DeepSeek API
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# JWT
JWT_SECRET=change-me-in-production-use-a-real-random-string
